---
interface Props {
  href: string;
  title: string;
  icon: "route" | "ports";
}

const { href, title, icon } = Astro.props;
---

<a class="home-cta" href={href}>
  {
    icon === "route" ? (
      <svg
        class="home-cta__icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
      </svg>
    ) : (
      <svg
        class="home-cta__icon"
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="5" r="3"></circle>
        <line x1="12" x2="12" y1="22" y2="8"></line>
        <path d="M5 12H2a10 10 0 0 0 20 0h-3"></path>
      </svg>
    )
  }
  <span class="home-cta__title">{title}</span>
</a>
